{
  "name": "wp-checkpoint",
  "private": true,
  "scripts": {
    "env:start": "wp-env start",
    "env:stop": "wp-env stop",
    "test:integration": "wp-env run tests-cli --env-cwd=wp-content/plugins/wp-checkpoint composer test:integration",
    "check:plugin": "npm run build:dist && wp-env run cli wp plugin check wp-content/plugins/wp-checkpoint/build/wp-checkpoint --format=table",
    "build:dist": "bash bin/build-dist.sh"
  },
  "devDependencies": {
    "@wordpress/env": "^11.15.0"
  }
}
